{
  "name": "Fullfin — Controle Financeiro",
  "short_name": "Fullfin",
  "description": "Controle financeiro da casa e dos negócios",
  "start_url": "/fullfin/",
  "scope": "/fullfin/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B1F5C",
  "theme_color": "#0B1F5C",
  "icons": [
    {
      "src": "ff-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "ff-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/fullfin/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "application/pdf",
            "application/octet-stream",
            "*/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Lançar por voz",
      "short_name": "Lançar por voz",
      "description": "Abre o Fullfin já gravando um lançamento",
      "url": "/fullfin/?voz=1",
      "icons": [
        {
          "src": "ff-icon-voz-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
